// ================================================================================
// SGCI - Sistema de Gestión Contextual Integrado
//
// Modelo de datos principal.
// ================================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoDocumentoIdentidad {
  CARNET_IDENTIDAD
  PASAPORTE
}

enum EstadoIdentidad {
  PENDIENTE_VERIFICACION
  VERIFICADA
  EN_CONFLICTO
  RECHAZADA
}

enum EstadoConflictoIdentidad {
  ABIERTO
  EN_REVISION
  RESUELTO
  DESCARTADO
}

enum TipoConflictoIdentidad {
  DOCUMENTO_DUPLICADO
  NOMBRES_DIFERENTES
  DATOS_PERSONALES_INCONSISTENTES
  DOCUMENTO_NO_VALIDO
}

enum EstadoGeocodificacion {
  PENDIENTE
  EN_PROCESO
  GEOCODIFICADA
  NO_ENCONTRADA
  AMBIGUA
  ERROR
  REQUIERE_REVISION
}

model Persona {
  id             String               @id @default(uuid()) @db.Uuid
  nombres        String
  apellidos      String
  nombreCompleto String
  activo         Boolean              @default(true)
  documentos     DocumentoIdentidad[]
  direcciones    Direccion[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  conflictosExistentes ConflictoIdentidad[] @relation("PersonaExistenteConflicto")
  conflictosNuevos     ConflictoIdentidad[] @relation("PersonaNuevaConflicto")
  @@index([nombres])
  @@index([apellidos])
  @@index([nombreCompleto])
}

model DocumentoIdentidad {
  id             String                 @id @default(uuid()) @db.Uuid
  personaId      String                 @db.Uuid
  tipo           TipoDocumentoIdentidad
  numero         String
  numeroOriginal String?
  estado         EstadoIdentidad        @default(PENDIENTE_VERIFICACION)
  esPrincipal    Boolean                @default(false)
  verificadoAt   DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  persona Persona @relation(fields: [personaId], references: [id], onDelete: Restrict)
  @@unique([tipo, numero])
  @@index([numero])
  @@index([estado])
}

model Direccion {
  id                    String                               @id @default(uuid()) @db.Uuid
  personaId             String                               @db.Uuid
  direccionOriginal     String
  calle                 String?
  numero                String?
  entreCalles           String?
  localidad             String?
  municipio             String?
  provincia             String?
  pais                  String?
  codigoPostal          String?
  ubicacion             Unsupported("geography(Point,4326)")
  estadoGeocodificacion EstadoGeocodificacion                @default(PENDIENTE)
  geocodificadoAt       DateTime?
  esPrincipal           Boolean                              @default(false)
  activa                Boolean                              @default(true)
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt
  persona Persona @relation(fields: [personaId], references: [id], onDelete: Restrict)
  @@index([provincia])
  @@index([municipio])
  @@index([localidad])
  @@index([estadoGeocodificacion])
}

model ConflictoIdentidad {
  id                      String                   @id @default(uuid()) @db.Uuid
  personaExistenteId      String                   @db.Uuid
  personaNuevaId          String                   @db.Uuid
  tipoDocumento           TipoDocumentoIdentidad
  numeroDocumento         String
  numeroDocumentoOriginal String?
  datosOriginales         Json
  tipoConflicto           TipoConflictoIdentidad
  estado                  EstadoConflictoIdentidad @default(ABIERTO)
  resolucion              String?
  resueltoAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  personaExistente Persona @relation("PersonaExistenteConflicto", fields: [personaExistenteId], references: [id], onDelete: Restrict)
  personaNueva     Persona @relation("PersonaNuevaConflicto", fields: [personaNuevaId], references: [id], onDelete: Restrict)
  @@index([estado])
  @@index([tipoDocumento, numeroDocumento])
  @@index([personaExistenteId])
  @@index([personaNuevaId])
}

model MasterAwb {
  id          String      @id @default(uuid()) @db.Uuid
  numero      String      @unique
  manifiestos Manifiesto[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@index([numero])
}

model Manifiesto {
  id                 String   @id @default(uuid()) @db.Uuid
  masterAwbId        String   @db.Uuid
  agenteTransitario  String
  fecha              DateTime
  paisOrigen         String
  consignatario      String
  cantidadHouse      Int
  totalSacas         Int
  totalPersonas      Int
  pesoTotalKg        Decimal  @db.Decimal(12, 2)
  archivoNombre      String?
  archivoHash        String?
  importadoAt        DateTime @default(now())
  masterAwb MasterAwb @relation(fields: [masterAwbId], references: [id], onDelete: Restrict)
  guias    Guia[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([masterAwbId])
  @@index([fecha])
  @@index([agenteTransitario])
  @@unique([archivoHash])
}

model Guia {
  id                    String   @id @default(uuid()) @db.Uuid
  manifiestoId          String   @db.Uuid
  numeroHouse           String
  naturalezaCantidad    String
  pesoKg                Decimal  @db.Decimal(12, 2)
  bultos                Int
  remitenteNombre       String
  remitentePasaporte    String?
  destinatarioNombre    String
  destinatarioCarnet    String?
  telefonoDestinatario  String?
  direccionDestinatario String?
  estadoCobroOrigen     String?
  unidadDestino         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  manifiesto Manifiesto @relation(fields: [manifiestoId], references: [id], onDelete: Cascade)
  paquetes   Paquete[]
  @@unique([manifiestoId, numeroHouse])
  @@index([numeroHouse])
  @@index([manifiestoId])
  @@index([destinatarioCarnet])
  @@index([remitentePasaporte])
  @@index([unidadDestino])
}

model Paquete {
  id        String   @id @default(uuid()) @db.Uuid
  guiaId    String   @db.Uuid
  numero    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guia Guia @relation(fields: [guiaId], references: [id], onDelete: Cascade)
  @@unique([guiaId, numero])
  @@index([guiaId])
}

model ManifiestoImportacionJob {
  id                  String   @id @default(uuid()) @db.Uuid
  stage               String
  status              String
  message             String
  totalHouses         Int
  processedHouses     Int
  totalPeople         Int
  processedPeople     Int
  totalAddresses      Int
  processedAddresses  Int
  addressesGeocoded   Int
  addressesReused     Int
  addressesNotFound   Int
  addressesReview     Int
  errors              Int
  currentAddress      String?
  startedAt           DateTime
  updatedAt           DateTime @updatedAt
  completedAt         DateTime?
  elapsedMs           Int
  housesPerMinute     Float
  etaSeconds          Int?
  coverage            Float
  error               String?
  resultManifiestoId  String?  @db.Uuid
  resultMasterAwb     String?
  resultGuias         Int?
  resultPaquetes      Int?
  resultPersonas      Int?
  resultPesoTotalKg   String?
  resultWarnings      Int?
  attempt             Int      @default(0)
  workerId            String?
  heartbeatAt         DateTime?
  leaseUntil          DateTime?
  @@index([status])
  @@index([updatedAt])
  @@index([startedAt])
  @@index([resultManifiestoId])
  @@index([leaseUntil])
  @@index([status, leaseUntil])
}
