// ================================================================================
// SGCI - Sistema de Gestión Contextual Integrado
//
// Modelo de datos principal.
//
// Dominio actual:
//   - Personas.
//   - Documentos de identidad.
//   - Direcciones.
//   - Geocodificación.
//   - Conflictos de identidad.
//   - Continuidad operativa ante inconsistencias.
//   - Manifiestos de carga.
//   - Master AWB.
//   - House / guías.
//   - Bultos asociados a cada House.
//
// PostgreSQL constituye el motor principal de persistencia.
// PostGIS proporciona capacidades geográficas y espaciales.
// ================================================================================

// ================================================================================
// GENERADOR PRISMA CLIENT
// ================================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ================================================================================
// BASE DE DATOS
// ================================================================================

datasource db {
  provider = "postgresql"
}

// ================================================================================
// ENUMERACIONES
// ================================================================================

enum TipoDocumentoIdentidad {
  CARNET_IDENTIDAD
  PASAPORTE
}

enum EstadoIdentidad {
  PENDIENTE_VERIFICACION
  VERIFICADA
  EN_CONFLICTO
  RECHAZADA
}

enum EstadoConflictoIdentidad {
  ABIERTO
  EN_REVISION
  RESUELTO
  DESCARTADO
}

enum TipoConflictoIdentidad {
  DOCUMENTO_DUPLICADO
  NOMBRES_DIFERENTES
  DATOS_PERSONALES_INCONSISTENTES
  DOCUMENTO_NO_VALIDO
}

enum EstadoGeocodificacion {
  PENDIENTE
  EN_PROCESO
  GEOCODIFICADA
  NO_ENCONTRADA
  AMBIGUA
  ERROR
  REQUIERE_REVISION
}

// Estado del House según el valor recibido desde el manifiesto.
// Se conserva como texto en Guia para no perder códigos del documento de origen.

// =============================================================================
// PERSONA
// =============================================================================

model Persona {
  id             String               @id @default(uuid()) @db.Uuid
  nombres        String
  apellidos      String
  nombreCompleto String
  activo         Boolean              @default(true)
  documentos     DocumentoIdentidad[]
  direcciones    Direccion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conflictosExistentes ConflictoIdentidad[] @relation("PersonaExistenteConflicto")
  conflictosNuevos     ConflictoIdentidad[] @relation("PersonaNuevaConflicto")

  @@index([nombres])
  @@index([apellidos])
  @@index([nombreCompleto])
}

// =============================================================================
// DOCUMENTO DE IDENTIDAD
// =============================================================================

model DocumentoIdentidad {
  id             String                 @id @default(uuid()) @db.Uuid
  personaId      String                 @db.Uuid
  tipo           TipoDocumentoIdentidad
  numero         String
  numeroOriginal String?
  estado         EstadoIdentidad        @default(PENDIENTE_VERIFICACION)
  esPrincipal    Boolean                @default(false)
  verificadoAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Restrict)

  @@unique([tipo, numero])
  @@index([numero])
  @@index([estado])
}

// =============================================================================
// DIRECCIÓN
// =============================================================================

model Direccion {
  id                    String                               @id @default(uuid()) @db.Uuid
  personaId             String                               @db.Uuid
  direccionOriginal     String
  calle                 String?
  numero                String?
  entreCalles           String?
  localidad             String?
  municipio             String?
  provincia             String?
  pais                  String?
  codigoPostal          String?
  ubicacion             Unsupported("geography(Point,4326)")
  estadoGeocodificacion EstadoGeocodificacion                @default(PENDIENTE)
  geocodificadoAt       DateTime?
  esPrincipal           Boolean                              @default(false)
  activa                Boolean                              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Restrict)

  @@index([provincia])
  @@index([municipio])
  @@index([localidad])
  @@index([estadoGeocodificacion])
}

// =============================================================================
// CONFLICTO DE IDENTIDAD
// =============================================================================

model ConflictoIdentidad {
  id                      String                   @id @default(uuid()) @db.Uuid
  personaExistenteId      String                   @db.Uuid
  personaNuevaId          String                   @db.Uuid
  tipoDocumento           TipoDocumentoIdentidad
  numeroDocumento         String
  numeroDocumentoOriginal String?
  datosOriginales        Json
  tipoConflicto           TipoConflictoIdentidad
  estado                  EstadoConflictoIdentidad @default(ABIERTO)
  resolucion              String?
  resueltoAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personaExistente Persona @relation("PersonaExistenteConflicto", fields: [personaExistenteId], references: [id], onDelete: Restrict)
  personaNueva     Persona @relation("PersonaNuevaConflicto", fields: [personaNuevaId], references: [id], onDelete: Restrict)

  @@index([estado])
  @@index([tipoDocumento, numeroDocumento])
  @@index([personaExistenteId])
  @@index([personaNuevaId])
}

// =============================================================================
// MASTER AWB
// =============================================================================

// Documento Master que agrupa uno o varios manifiestos.
model MasterAwb {
  id          String      @id @default(uuid()) @db.Uuid
  numero      String      @unique
  manifiestos Manifiesto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([numero])
}

// =============================================================================
// MANIFIESTO
// =============================================================================

// Cabecera del manifiesto importado desde Excel/CSV.
model Manifiesto {
  id                 String   @id @default(uuid()) @db.Uuid
  masterAwbId        String   @db.Uuid
  agenteTransitario  String
  fecha              DateTime
  paisOrigen         String
  consignatario      String
  cantidadHouse      Int
  totalSacas         Int
  totalPersonas      Int

  // Peso declarado en la fila de total del manifiesto.
  // NO se debe sumar nuevamente esta fila como si fuera un House.
  pesoTotalKg        Decimal  @db.Decimal(12, 2)

  archivoNombre      String?
  archivoHash        String?
  importadoAt        DateTime @default(now())

  masterAwb MasterAwb @relation(fields: [masterAwbId], references: [id], onDelete: Restrict)
  guias    Guia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([masterAwbId])
  @@index([fecha])
  @@index([agenteTransitario])
}

// =============================================================================
// HOUSE / GUÍA
// =============================================================================

// Representa cada House del manifiesto.
model Guia {
  id                    String   @id @default(uuid()) @db.Uuid
  manifiestoId          String   @db.Uuid
  numeroHouse           String
  naturalezaCantidad    String
  pesoKg                Decimal  @db.Decimal(12, 2)
  bultos                Int

  remitenteNombre       String
  remitentePasaporte    String?

  destinatarioNombre    String
  destinatarioCarnet    String?
  telefonoDestinatario  String?
  direccionDestinatario String?

  // Valor original de la columna "Identificación si el House está COBRADO ó NO COBRADO en origen".
  estadoCobroOrigen     String?

  unidadDestino         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manifiesto Manifiesto @relation(fields: [manifiestoId], references: [id], onDelete: Cascade)
  paquetes   Paquete[]

  @@unique([manifiestoId, numeroHouse])
  @@index([numeroHouse])
  @@index([manifiestoId])
  @@index([destinatarioCarnet])
  @@index([remitentePasaporte])
  @@index([unidadDestino])
}

// =============================================================================
// PAQUETE / BULTO
// =============================================================================

// Detalle físico asociado a un House.
// En el manifiesto actual la columna "Bultos (Cant.)" indica la cantidad de bultos.
model Paquete {
  id        String  @id @default(uuid()) @db.Uuid
  guiaId    String  @db.Uuid
  numero    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guia Guia @relation(fields: [guiaId], references: [id], onDelete: Cascade)

  @@unique([guiaId, numero])
  @@index([guiaId])
}
